{
  "name": "blog-news-crawler",
  "version": "1.0.0",
  "description": "네이버 뉴스 자동 크롤링 시스템",
  "main": "news-scheduler.js",
  "scripts": {
    "dev": "npx http-server -p 8080 -c-1",
